{
  "name": "daily-devotional",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions/tsconfig.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=daily-devotional",
    "db:migrate:local": "wrangler d1 migrations apply daily-devotional-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply daily-devotional-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "html2canvas": "^1.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
